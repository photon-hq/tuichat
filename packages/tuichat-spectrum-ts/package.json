{
  "name": "tuichat-spectrum-ts",
  "version": "0.1.0",
  "description": "Spectrum-TS provider that drives the standalone tuichat TUI over JSON-RPC.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "tuichat": "workspace:*"
  },
  "peerDependencies": {
    "spectrum-ts": "^0.4.0",
    "typescript": "^5",
    "zod": "^4"
  },
  "devDependencies": {
    "spectrum-ts": "^0.4.0",
    "tsup": "^8.4.0",
    "zod": "^4.2.1"
  },
  "license": "MIT"
}
