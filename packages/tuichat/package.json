{
  "name": "@photon-ai/tuichat",
  "version": "0.1.0",
  "description": "A standalone, language-agnostic TUI chat subprocess for Spectrum adapters. Powered by OpenTUI React; speaks JSON-RPC 2.0 over TCP.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "tuichat": "dist/bin/tuichat.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "release": "bun run build && bun publish --access public"
  },
  "dependencies": {
    "@opentui/core": "^0.1.101",
    "@opentui/react": "^0.1.101",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "tsup": "^8.4.0"
  },
  "license": "MIT"
}
