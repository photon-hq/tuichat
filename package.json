{
  "name": "tuichat-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "bun --filter='./packages/*' run build",
    "typecheck": "bun --filter='./packages/*' run typecheck",
    "example:echo": "bun --filter='@tuichat/example-echo' run start"
  },
  "devDependencies": {
    "@opentui/core": "0.1.101",
    "@opentui/react": "0.1.101",
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
